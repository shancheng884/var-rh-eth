[Unit]
Description=Robinhood Chain remote risk wakeup backup receiver
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/var-rh-eth
EnvironmentFile=/home/ubuntu/var-rh-eth/.env
ExecStart=/home/ubuntu/var-rh-eth/.venv/bin/python tools/risk_wakeup_backup.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
